rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOpsStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/ops_staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/ops_staff/$(request.auth.uid)).data.isActive == true;
    }

    function opsRole() {
      return get(/databases/$(database)/documents/ops_staff/$(request.auth.uid)).data.role;
    }

    function isOpsAdmin() {
      return isOpsStaff() && opsRole() == 'platform_admin';
    }

    function isOpsManager() {
      return isOpsStaff() && opsRole() in [
        'support_manager', 'trust_manager', 'legal_manager',
        'finance_manager', 'verification_manager'
      ];
    }

    function isOpsAdminOrManager() {
      return isOpsAdmin() || isOpsManager();
    }

    function onlyFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // P1 fix — "engagement counters are freely writable": these two
    // predicates replace bare onlyFields([...]) escape hatches (which let
    // any authed non-owner set a counter/list to *any* value) on
    // posts/sparks/ideas/reels/buildLogs/aiPlaybooks/reelVibes/
    // wisdom_threads/arena_challenges/factory_startups.
    //
    // isSelfUidToggle: for a *ByUids-style list, requires the diff be
    // exactly the caller adding or removing their own uid — nobody can
    // touch another uid's membership or smuggle other changes in.
    function isSelfUidToggle(before, after) {
      return (after.size() == before.size() + 1
              && after.hasAll(before)
              && after.hasAny([request.auth.uid])
              && !before.hasAny([request.auth.uid]))
          || (before.size() == after.size() + 1
              && before.hasAll(after)
              && before.hasAny([request.auth.uid])
              && !after.hasAny([request.auth.uid]));
    }

    // isCounterBump: for a plain numeric counter (no per-user tracking
    // exists on these docs to key a toggle off), requires the write move
    // it up by exactly 1 — blocks setting it to an arbitrary/negative
    // value or a bulk jump. NOTE: this does not by itself stop one
    // authenticated user from calling the same write many times across
    // separate requests to farm the counter — closing that fully needs
    // per-user tracking (like isSelfUidToggle's fields) or a Cloud
    // Function, which not every counter fixed here has; each call site
    // below notes which is which.
    function isCounterBump(before, after) {
      return (before is int || before is float)
          && (after is int || after is float)
          && after == before + 1;
    }

    function isPlatformAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isPlatformAdmin', false) == true;
    }

    // P1 fix ("no verified-recruiter check on jobs/opportunities create"):
    // isRecruiter is now safe to gate on — it can only be set at account
    // creation (the real signup checkbox) and can never be flipped by a
    // later update (see the users/{uid} block below), so a plain user
    // can no longer self-escalate into this check after the fact.
    function isRecruiter() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isRecruiter', false) == true;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // ── Factory identity helpers (Decision 4) ──────────────────────────────
    // A Factory-only investor account: a Firebase Auth user with a
    // factory_investors doc but NO users/{uid} BeWatu profile.
    function isFactoryInvestor() {
      return isAuth() &&
        exists(/databases/$(database)/documents/factory_investors/$(request.auth.uid));
    }
    // A BeWatu member whose project has been promoted into Factory.
    function isFactoryMember() {
      return isAuth() &&
        exists(/databases/$(database)/documents/factory_users/$(request.auth.uid));
    }

    // ═══════════════════════════════════════════════════════════════════
    // OPS PORTAL — ops.bewatu.com
    // ═══════════════════════════════════════════════════════════════════

    match /ops_staff/{uid} {
      allow read: if isOpsStaff() || (isAuth() && request.auth.uid == uid);

      allow create: if isAuth() && (
        isOpsAdmin()
        || (
          request.resource.data.keys().hasAll([
            'email', 'name', 'role', 'invitedBy', 'isActive', 'mfaEnabled'
          ]) &&
          request.resource.data.isActive == true &&
          request.resource.data.invitedBy != null &&
          exists(/databases/$(database)/documents/ops_staff/$(request.resource.data.invitedBy)) &&
          get(/databases/$(database)/documents/ops_staff/$(request.resource.data.invitedBy)).data.isActive == true &&
          get(/databases/$(database)/documents/ops_staff/$(request.resource.data.invitedBy)).data.role == 'platform_admin'
        )
      );

      allow update: if isOpsAdmin() || (
        isOpsManager() &&
        resource.data.assignedQueue ==
          get(/databases/$(database)/documents/ops_staff/$(request.auth.uid)).data.assignedQueue &&
        request.resource.data.role in [
          'support_agent', 'trust_agent', 'legal_agent',
          'finance_agent', 'verification_agent', 'auditor'
        ]
      );

      allow delete: if isOpsAdmin();
    }

    match /audit_log/{entryId} {
      allow read: if isOpsStaff();
      // P1 fix: create didn't bind actorUid to the real caller —
      // writeAuditEntry() (bewatu-ops/src/App.jsx) takes actorUid as a
      // plain parameter rather than deriving it server-side, so nothing
      // stopped any ops staff member writing an entry that misattributes
      // an action to a different staffer, undermining the audit trail's
      // own integrity.
      allow create: if isOpsStaff()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // P1 fix ("ops role tiers not enforced"): create/update was a blanket
    // `if isOpsStaff()` — bewatu-ops's own ROLES definition documents
    // auditor as "Read-only access to all modules and audit log. No
    // write permissions" and doesn't grant cyber_agent the tickets
    // domain at all (its domain is Security), but nothing at the data
    // layer enforced either restriction — both roles could create/
    // update/delete any ticket directly through the client SDK,
    // bypassing the UI-level restriction entirely.
    match /support_tickets/{ticketId} {
      allow read: if isOpsStaff();
      allow create, update: if isOpsStaff()
        && opsRole() != 'auditor' && opsRole() != 'cyber_agent';
      // Tickets are resolved/closed by the app, never actually deleted —
      // restrict delete to platform_admin, matching the same
      // immutable-trail posture audit_log/ops_staff deletion already
      // has elsewhere in this file.
      allow delete: if isOpsAdmin();
    }

    match /fraud_cases/{caseId} {
      allow read: if isOpsStaff();
      allow write: if isOpsStaff() && opsRole() in [
        'platform_admin', 'trust_manager', 'trust_agent'
      ];
    }

    match /content_reports/{reportId} {
      // P0 4 fix: was `if isAuth()` — any signed-in user could read every
      // abuse report and the identity of who filed it. Now: the reporter
      // sees their own report's status, ops sees everything.
      allow read:   if isAuth() && (
        resource.data.reportedBy == request.auth.uid || isOpsStaff()
      );
      allow create: if isAuth();
      allow update: if isOpsStaff() && opsRole() in [
        'platform_admin', 'trust_manager', 'trust_agent',
        'support_manager', 'support_agent'
      ];
      allow delete: if isOpsAdmin();
    }

    match /credential_change_requests/{reqId} {
      allow read: if isAuth() && (
        resource.data.uid == request.auth.uid
        || (isOpsStaff() && opsRole() in [
             'platform_admin', 'legal_manager', 'support_manager'
           ])
      );
      allow create: if isAuth();
      allow update: if isOpsStaff() && opsRole() in [
        'platform_admin', 'legal_manager', 'support_manager'
      ];
      allow delete: if isOpsAdmin();
    }

    match /appeals/{appealId} {
      allow read:   if isOpsStaff();
      allow create: if isAuth();
      allow update: if isOpsStaff() && opsRole() in [
        'platform_admin', 'trust_manager', 'legal_manager', 'support_manager',
        'trust_agent', 'legal_agent'
      ];
      allow delete: if isOpsAdmin();
    }

    match /ops_bulletins/{bulletinId} {
      allow read:   if isOpsStaff();
      allow create: if isOpsAdminOrManager();
      allow update: if isOpsAdminOrManager();
      allow delete: if isOpsAdminOrManager();
    }

    match /ticket_macros/{macroId} {
      allow read:   if isOpsStaff();
      allow create: if isOpsStaff() && opsRole() != 'auditor';
      allow update: if isOpsAdminOrManager();
      allow delete: if isOpsAdminOrManager();
    }

    match /ops_config/{configId} {
      allow read:  if isOpsStaff();
      allow write: if isOpsAdmin();
    }

    match /report_runs/{runId} {
      allow read:  if isOpsAdminOrManager();
      allow write: if isOpsAdmin();
    }

    match /report_trigger_requests/{reqId} {
      allow read:   if isOpsAdminOrManager();
      allow create: if isOpsAdminOrManager();
      allow update: if isOpsAdmin();
      allow delete: if isOpsAdmin();
    }

    match /kb_articles/{articleId} {
      allow read:   if isAuth();
      allow create: if isOpsStaff();
      allow update: if isOpsAdminOrManager();
      allow delete: if isOpsAdmin();
    }

    match /ticket_presence/{ticketId}/viewers/{viewerUid} {
      allow read:  if isOpsStaff();
      allow write: if isOpsStaff() && request.auth.uid == viewerUid;
    }

    match /ticket_time_logs/{ticketId}/sessions/{sessionId} {
      allow read:   if isOpsAdminOrManager();
      allow create: if isOpsStaff();
      allow update: if false;
      allow delete: if isOpsAdmin();
    }

    match /ticket_emails/{emailId} {
      allow read:  if isOpsStaff();
      allow write: if false;
    }

    match /csat_tokens/{tokenId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /watchlist_fraud/{entryId} {
      allow read:   if isOpsStaff();
      allow create: if isOpsStaff() && opsRole() != 'auditor';
      allow update: if isOpsStaff() && opsRole() in [
        'platform_admin', 'trust_manager', 'legal_manager', 'support_manager',
        'trust_agent', 'legal_agent', 'investigator'
      ];
      allow delete: if isOpsAdmin();
    }
    match /watchlist_identity/{entryId} {
      allow read:   if isOpsStaff();
      allow create: if isOpsStaff() && opsRole() != 'auditor';
      allow update: if isOpsStaff() && opsRole() in [
        'platform_admin', 'trust_manager', 'legal_manager', 'support_manager',
        'trust_agent', 'legal_agent', 'investigator'
      ];
      allow delete: if isOpsAdmin();
    }
    match /watchlist_payment/{entryId} {
      allow read:   if isOpsStaff();
      allow create: if isOpsStaff() && opsRole() != 'auditor';
      allow update: if isOpsStaff() && opsRole() in [
        'platform_admin', 'trust_manager', 'legal_manager', 'finance_manager',
        'trust_agent', 'legal_agent', 'finance_agent', 'investigator'
      ];
      allow delete: if isOpsAdmin();
    }
    match /watchlist_platform/{entryId} {
      allow read:   if isOpsStaff();
      allow create: if isOpsStaff() && opsRole() != 'auditor';
      allow update: if isOpsStaff() && opsRole() in [
        'platform_admin', 'trust_manager', 'support_manager',
        'trust_agent', 'support_agent', 'investigator'
      ];
      allow delete: if isOpsAdmin();
    }
    match /watchlist_safety/{entryId} {
      allow read:   if isOpsStaff();
      allow create: if isOpsStaff() && opsRole() != 'auditor';
      allow update: if isOpsStaff() && opsRole() in [
        'platform_admin', 'trust_manager', 'legal_manager',
        'trust_agent', 'legal_agent', 'investigator'
      ];
      allow delete: if isOpsAdmin();
    }
    match /watchlist_legal/{entryId} {
      allow read:   if isOpsStaff();
      allow create: if isOpsStaff() && opsRole() != 'auditor';
      allow update: if isOpsStaff() && opsRole() in [
        'platform_admin', 'legal_manager', 'legal_agent', 'investigator'
      ];
      allow delete: if isOpsAdmin();
    }
    match /watchlist_aml/{entryId} {
      allow read:   if isOpsStaff();
      allow create: if isOpsStaff() && opsRole() != 'auditor';
      allow update: if isOpsStaff() && opsRole() in [
        'platform_admin', 'legal_manager', 'finance_manager',
        'legal_agent', 'finance_agent', 'investigator'
      ];
      allow delete: if isOpsAdmin();
    }
    match /watchlist_dsr/{entryId} {
      allow read:   if isOpsStaff();
      allow create: if isOpsStaff() && opsRole() != 'auditor';
      allow update: if isOpsStaff() && opsRole() in [
        'platform_admin', 'legal_manager', 'support_manager',
        'legal_agent', 'support_agent', 'investigator'
      ];
      allow delete: if isOpsAdmin();
    }

    match /fraud_list/{userId} {
      allow read:   if isOpsStaff();
      allow create: if isOpsStaff() && opsRole() in [
        'platform_admin', 'trust_manager', 'legal_manager', 'investigator'
      ];
      allow update: if isOpsStaff() && opsRole() in [
        'platform_admin', 'trust_manager', 'legal_manager', 'investigator'
      ];
      allow delete: if false;
    }

    match /investigations/{caseId} {
      allow read:   if isOpsStaff();
      allow create: if isOpsStaff() && opsRole() != 'auditor';
      allow update: if isOpsStaff() && opsRole() in [
        'platform_admin', 'trust_manager', 'legal_manager', 'support_manager',
        'trust_agent', 'legal_agent', 'investigator'
      ];
      allow delete: if isOpsAdmin();
    }

    match /ops_staff/{uid}/policy_acks/{policyCode} {
      allow read: if isAuth() && (request.auth.uid == uid || isOpsAdminOrManager());
      allow create: if isAuth() && request.auth.uid == uid
        && request.resource.data.staffUid == uid;
      allow update: if isAuth() && request.auth.uid == uid;
      allow delete: if isOpsAdmin();
    }

    match /ops_config/policy_versions {
      allow read:  if isOpsStaff();
      allow write: if isOpsAdmin();
    }

    // ── SECURITY PLATFORM ─────────────────────────────────────────────

    match /security_findings/{findingId} {
      allow read: if isOpsStaff() || isPlatformAdmin();
      allow write: if false;

      match /evidence/{evidenceId} {
        allow read: if isOpsStaff() || isPlatformAdmin();
        allow write: if false;
      }
    }

    match /remediation_plans/{planId} {
      allow read: if isOpsStaff() || isPlatformAdmin();
      allow write: if false;
    }

    match /approval_requests/{requestId} {
      allow read:   if isOpsStaff() || isPlatformAdmin();
      allow update: if isOpsStaff() && (
        request.resource.data.status == 'approved' ||
        request.resource.data.status == 'rejected'
      );
      allow create, delete: if false;
    }

    match /asset_graph/{assetId} {
      allow read:  if isOpsStaff() || isPlatformAdmin();
      allow write: if false;
    }

    match /asset_edges/{edgeId} {
      allow read:  if isOpsStaff() || isPlatformAdmin();
      allow write: if false;
    }

    match /security_events/{eventId} {
      allow read:  if isOpsStaff() || isPlatformAdmin();
      allow write: if false;
    }

    match /security_config/{configId} {
      allow read:  if isOpsStaff() || isPlatformAdmin();
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // BEWATU.COM — CORE PLATFORM
    // ═══════════════════════════════════════════════════════════════════

    match /trust_edges/{edgeId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /reputation_profiles/{uid} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /users/{uid} {
      // Unauthenticated reads allowed only for public profiles (required for /be/:username).
      // Any authenticated user can read any user document — the UI enforces what
      // is displayed based on isPublic (name+pic only for private; full profile for public).
      // This mirrors standard professional-network behaviour: you can see someone exists
      // and request to connect, but their full profile is gated on their privacy setting.
      allow read:   if (resource.data.isPublic == true)
                    || isAuth();
      // CRITICAL fix — self-escalation to platform admin: create and
      // update here had zero field restrictions, so any authenticated
      // user (including a brand-new signup, via create) could set
      // isPlatformAdmin: true on their own doc directly through the
      // client SDK. isPlatformAdmin() is then read as an escalated-
      // privilege bypass in ~40 other rules across this file — this was
      // a full platform-admin self-grant, confirmed empirically against
      // the real emulator before this fix. Grepped every write site in
      // both BeWatu_V3 and bewatu-ops and found none that ever
      // legitimately sets isPlatformAdmin at all — it's frozen from
      // every client write below, owner and admin/ops alike, leaving
      // only Admin SDK / Firebase Console to set it.
      //
      // isRecruiter is a different case — CORRECTING an earlier version
      // of this fix that wrongly froze it the same way. It DOES have a
      // real, legitimate, currently-working client write path: the
      // plain "I'm a recruiter" checkbox on RegistrationPage, which
      // registerWithEmail()/upsertGoogleUser() (lib/firebaseAuth.ts) bake
      // straight into buildNewUserDoc()'s create write, unverified by
      // design. Freezing it at create would have rejected every new
      // recruiter signup — caught before this shipped anywhere but
      // bewatu-dev. So: isRecruiter may be set to anything at create
      // time (matching real signup behavior), but — like
      // isPlatformAdmin — can never be changed by a later update. The
      // separate OTP+application "upgrade" flow (RecruiterUpgradeModal)
      // only ever writes recruiterStatus: 'pending_ops' and a
      // recruiter_applications doc, never isRecruiter itself, and
      // nothing anywhere processes that application — a real,
      // previously-unknown functional gap, flagged separately, not
      // something this rule needs to accommodate today.
      allow create: if isAuth() && request.auth.uid == uid
        && request.resource.data.get('isPlatformAdmin', false) == false;
      allow update: if isAuth() && (
        request.auth.uid == uid || isPlatformAdmin() || isOpsStaff()
      ) && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['isPlatformAdmin', 'isRecruiter']);
      allow delete: if false;

      // Notifications subcollection — pod invites, approvals, activity.
      // P1 fix: create used to be a blanket `if isAuth()` — literally any
      // signed-in user could write anything into any other user's
      // notification feed (fake approvals, arbitrary junk `type`/
      // `message` values, pre-marked-read entries). The sender is
      // legitimately a different user than the recipient (`uid` in the
      // path) by design, so this can't be an ownership check — it's
      // restricted instead to the real shape every current write site
      // (createPodNotification, the post-comment/circle-approval/
      // -denial/-join-request/-invite notifiers) actually produces: a
      // known `type`, a string `message`, unread at creation, and a
      // server-stamped `createdAt`. This doesn't stop a determined
      // authed user from calling it repeatedly to spam legitimate-shaped
      // notifications — closing that needs rate limiting or a Cloud
      // Function, not something rules alone can do.
      match /notifications/{notifId} {
        allow read:   if isAuth() && request.auth.uid == uid;
        allow create: if isAuth()
          && request.resource.data.type in [
               'circle_invite', 'circle_approved', 'circle_denied',
               'circle_join_request', 'post_comment'
             ]
          && request.resource.data.message is string
          && request.resource.data.isRead == false
          && request.resource.data.createdAt == request.time;
        allow update: if isAuth() && request.auth.uid == uid;
        allow delete: if isAuth() && request.auth.uid == uid;
      }

      // Per-pod notification preferences
      match /podPrefs/{podId} {
        allow read, write: if isAuth() && request.auth.uid == uid;
      }

      // P0 2 fix: email, phone, location and stripeCustomerId used to live on
      // the users/{uid} doc itself, readable by ANY authenticated user (the
      // parent read rule above is isPublic==true || isAuth() — necessarily
      // whole-document, since rules can't restrict individual fields on one
      // doc). Split into this owner/ops-only subcollection instead.
      match /private/{docId} {
        allow read, write: if isAuth() && (request.auth.uid == uid || isPlatformAdmin() || isOpsStaff());
      }

      // Security audit events
      match /securityEvents/{eventId} {
        allow read:           if isAuth() && request.auth.uid == uid;
        allow create:         if isAuth() && request.auth.uid == uid;
        allow update, delete: if false;
      }

      // Behavioral telemetry — the user writes their own events; only the user
      // and platform/ops can read. These are personalization data gated on the
      // user's Analytics consent at the client (see eventLogger.ts). No client
      // can read another user's event stream. Append-only.
      match /events/{eventId} {
        allow create:         if isAuth() && request.auth.uid == uid
                              && request.resource.data.userId == request.auth.uid;
        allow read:           if isAuth() && (request.auth.uid == uid || isPlatformAdmin() || isOpsStaff());
        allow update, delete: if false;
      }

      // Cached recommendation profile — content preferences only, owner-private.
      // Never readable by other users; never exposed to recruiter surfaces.
      match /recommendation/{docId} {
        allow read:  if isAuth() && request.auth.uid == uid;
        allow write: if isAuth() && request.auth.uid == uid;
      }
    }

    match /posts/{postId} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read:   if isAuth();
        allow create: if isAuth()
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isAuth()
          && resource.data.authorUid == request.auth.uid;
      }
      // P1 fix: appreciations/comments/shares used to be a blanket
      // onlyFields() escape hatch — any authed non-owner could set any of
      // the three to any value in one write (including a full-map
      // overwrite of appreciations, or a negative/bulk jump on comments/
      // shares). appreciatePost() only ever bumps exactly one
      // appreciations.<type> sub-field by 1; comments/shares have no
      // current app write site at all (dead counters as of this pass, but
      // still reachable by any raw client, so still worth closing).
      allow update: if isAuth() && (
        resource.data.authorUid == request.auth.uid
        || (onlyFields(['comments', 'updatedAt'])
            && isCounterBump(resource.data.comments, request.resource.data.comments))
        || (onlyFields(['shares', 'updatedAt'])
            && isCounterBump(resource.data.shares, request.resource.data.shares))
        || (onlyFields(['appreciations', 'updatedAt']) && (
              (isCounterBump(resource.data.appreciations.get('helpful', 0), request.resource.data.appreciations.get('helpful', 0))
                && request.resource.data.appreciations.get('thoughtProvoking', 0) == resource.data.appreciations.get('thoughtProvoking', 0)
                && request.resource.data.appreciations.get('collaborationReady', 0) == resource.data.appreciations.get('collaborationReady', 0))
           || (isCounterBump(resource.data.appreciations.get('thoughtProvoking', 0), request.resource.data.appreciations.get('thoughtProvoking', 0))
                && request.resource.data.appreciations.get('helpful', 0) == resource.data.appreciations.get('helpful', 0)
                && request.resource.data.appreciations.get('collaborationReady', 0) == resource.data.appreciations.get('collaborationReady', 0))
           || (isCounterBump(resource.data.appreciations.get('collaborationReady', 0), request.resource.data.appreciations.get('collaborationReady', 0))
                && request.resource.data.appreciations.get('helpful', 0) == resource.data.appreciations.get('helpful', 0)
                && request.resource.data.appreciations.get('thoughtProvoking', 0) == resource.data.appreciations.get('thoughtProvoking', 0))
           ))
        || (isOpsStaff() && opsRole() in ['platform_admin','trust_manager','trust_agent','support_manager','support_agent'])
      );
      allow delete: if isAuth() && resource.data.authorUid == request.auth.uid
        || (isOpsStaff() && opsRole() in ['platform_admin','trust_manager','trust_agent']);
    }

    match /connections/{connectionId} {
      allow read: if isAuth() && (
        resource.data.senderUid == request.auth.uid
        || resource.data.receiverUid == request.auth.uid
      );
      allow create: if isAuth()
        && request.resource.data.senderUid == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.senderUid == request.auth.uid
        || resource.data.receiverUid == request.auth.uid
      );
      allow delete: if false;
    }

    // ── CIRCLES (new pods schema) ──────────────────────────────────────

    match /circles/{circleId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        request.resource.data.adminId == request.resource.data.members[0]
        || isPlatformAdmin()
      );
      // P0 3 fix: was `if isAuth()` — any signed-in user could rewrite any
      // circle (adminId, members, name). Same convention as pods below:
      // admin can change anything; members can only change their own
      // membership.
      allow update: if isAuth() && (
        resource.data.adminId == request.auth.uid
        || isPlatformAdmin()
        || isOpsStaff()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
      );
      allow delete: if false;

      // Pod challenges subcollection.
      // NOT fixed here: CircleDetail.tsx's handlePostChallenge writes
      // `postedBy: currentUser.name` — a display name, not a uid — so
      // there is no field to check ownership against yet. Needs an
      // P0 3 fix: the app now writes postedByUid alongside postedBy
      // (same pattern as the factory_team_posts.authorUid fix). Create
      // requires it to match the caller; only the author can edit the
      // question/context or delete; any authed user can still update
      // responses/upvotes/synthesis/status (not implemented in the app
      // yet, but scoped now so it's not a blanket `if isAuth()` update
      // once it is).
      match /challenges/{challengeId} {
        allow read: if isAuth();
        allow create: if isAuth()
          && request.resource.data.postedByUid == request.auth.uid;
        allow update: if isAuth() && (
          resource.data.postedByUid == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['responses', 'upvotes', 'synthesis', 'status'])
        );
        allow delete: if isAuth() && resource.data.postedByUid == request.auth.uid;
      }

      // Per-member preferences subcollection — memberId is the member's
      // own uid, so this can be scoped directly off the path.
      match /members/{memberId} {
        allow read, write: if isAuth() && request.auth.uid == memberId;
      }
    }

    // ── PODS (legacy pods schema with Firebase UID members) ───────────

    match /pods/{podId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        // Admin can update anything
        resource.data.adminUid == request.auth.uid
        || resource.data.creatorUid == request.auth.uid
        || isPlatformAdmin()
        || isOpsStaff()
        // Any authenticated user can add themselves to pendingMembers (request to join)
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingMembers', 'updatedAt'])
        )
        // Any authenticated user can remove themselves from pendingInvites (accept/decline invite)
        // or add themselves to members (if they were invited)
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingInvites', 'members', 'updatedAt'])
        )
        // Members can update their own membership (leave)
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
        )
      );
      allow delete: if isAuth() && (
        resource.data.adminUid == request.auth.uid
        || resource.data.adminId == request.auth.uid
        || isPlatformAdmin()
      );

      // P0 3 fix: same as circles/challenges above. The app always writes
      // pod challenges under circles/{id}/challenges regardless of whether
      // the pod's doc actually lives in `pods` or `circles` (see
      // lib/firestoreService.ts fetchCircles' unified-id convention), so
      // this block is currently unreached in practice — kept in sync with
      // the circles version rather than left stale, in case that changes.
      match /challenges/{challengeId} {
        allow read: if isAuth();
        allow create: if isAuth()
          && request.resource.data.postedByUid == request.auth.uid;
        allow update: if isAuth() && (
          resource.data.postedByUid == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['responses', 'upvotes', 'synthesis', 'status'])
        );
        allow delete: if isAuth() && resource.data.postedByUid == request.auth.uid;
      }
    }

    match /messages/{threadId} {
      allow read: if isAuth() && (
        resource == null
        || resource.data.participants.hasAny([request.auth.uid])
      );
      allow create: if isAuth()
        && request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isAuth()
        && resource.data.participants.hasAny([request.auth.uid]);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isAuth() && (
          resource == null
          || resource.data.senderUid == request.auth.uid
          || resource.data.receiverUid == request.auth.uid
        );
        allow create: if isAuth()
          && request.resource.data.senderUid == request.auth.uid;
        allow update: if isAuth()
          && resource.data.receiverUid == request.auth.uid
          && onlyFields(['isRead', 'updatedAt']);
        allow delete: if false;
      }
    }

    // Legacy top-level notifications collection. The parent notifications/{uid}
    // doc itself is never created or written by any app code — only its
    // items subcollection below is ever used (createNotification() writes
    // straight to notifications/{recipientUid}/items) — so create is
    // closed outright here rather than left open for nothing to use.
    match /notifications/{notifId} {
      allow read:   if isAuth() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && onlyFields(['read', 'readAt']);
      allow delete: if false;

      // P1 fix: create used to be a blanket `if isAuth()` — any signed-in
      // user could write anything into any other user's items feed. The
      // sender is legitimately a different user than the recipient
      // (notifId here) by design, so restricted instead to the real
      // shape createNotification() actually produces: a known
      // NotificationType, a string message, unread at creation, a
      // server-stamped createdAt. Same residual gap as the sibling
      // users/{uid}/notifications fix above: this can't stop a
      // determined authed user from calling it repeatedly to spam
      // legitimate-shaped notifications.
      match /items/{itemId} {
        allow read:   if isAuth() && isOwner(notifId);
        allow create: if isAuth()
          && request.resource.data.type in [
               'MESSAGE', 'ENDORSEMENT', 'CONNECTION_REQUEST',
               'CONNECTION_ACCEPTED', 'FOLLOW_REQUEST', 'FOLLOW_ACCEPTED',
               'SECURITY_ALERT'
             ]
          && request.resource.data.message is string
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time;
        allow update: if isAuth()
          && isOwner(notifId)
          && onlyFields(['read', 'readAt']);
        allow delete: if false;
      }
    }

    match /companies/{companyId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.adminUid == request.auth.uid
        || onlyFields(['verifiedRecruiters', 'updatedAt'])
        || isOpsStaff()
        || isPlatformAdmin()
      );
      allow delete: if isAuth() && resource.data.adminUid == request.auth.uid;
    }

    match /companyAdmins/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /jobs/{jobId} {
      allow read:   if isAuth();
      // Real bug fix, found investigating the P1 recruiter-check gap
      // below: this checked recruiterId == request.auth.uid, but
      // recruiterId is the app-level numeric id (Job.recruiterId:
      // number) — the real write site (lib/firestoreService.ts's
      // createJob) stamps the actual caller uid onto a separate field,
      // recruiterUid. A number can never equal request.auth.uid (a
      // string), so this rule denied every real job create/update/
      // delete outright — confirmed empirically against the real write
      // shape before this fix. Also adds the missing recruiter check
      // this P1 was actually about: create now requires isRecruiter()
      // in addition to ownership.
      allow create: if isAuth()
        && request.resource.data.recruiterUid == request.auth.uid
        && isRecruiter();
      allow update: if isAuth()
        && resource.data.recruiterUid == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.recruiterUid == request.auth.uid;
    }

    // ── TOP-LEVEL CHALLENGES ──────────────────────────────────────────────────
    // getChallenges() and getChallengesForCompany() both query this collection.
    // Without this rule Firestore denies all reads (default deny), which caused
    // permission-denied errors on the Showcase and Company pages.
    match /challenges/{challengeId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.createdBy == request.auth.uid
        || resource.data.companyId != null
        || isPlatformAdmin()
        || isOpsStaff()
      );
      allow delete: if isAuth() && (
        resource.data.createdBy == request.auth.uid
        || isPlatformAdmin()
      );

      // Submissions subcollection
      match /submissions/{submissionId} {
        allow read:   if isAuth();
        allow create: if isAuth();
        allow update: if isAuth() && (
          resource.data.userId == request.auth.uid
          || isPlatformAdmin()
          || isOpsStaff()
        );
        allow delete: if false;
      }
    }

    // ── AI-era proof features (profile showcase) ───────────────────────────
    // FEATURE 1 — AI Workflows: persistent AI orchestration recipes.
    // Public read (proof surface); author-only write.
    match /aiWorkflows/{workflowId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuth() && resource.data.authorUid == request.auth.uid;
      allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;
    }

    // FEATURE 3 — Learning Log: persistent weekly build-in-public entries.
    // Public read (proof surface); author-only write.
    match /learningLogs/{logId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuth() && resource.data.authorUid == request.auth.uid;
      allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;
    }

    // FEATURE 2 — Skills Trajectory insight: personal career guidance cache.
    // Owner-only read AND write (never shown to others — it's private guidance).
    match /users/{uid}/insights/{docId} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    match /sparks/{sparkId} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && (request.resource.data.authorUid == request.auth.uid
            || request.resource.data.authorId  == request.auth.uid);
      // P1 fix: reactions is {relate:[],inspire:[],collab:[]} (uids) — was
      // a blanket onlyFields() escape hatch letting anyone set any of the
      // three arrays to anything. toggleSparkReaction() always
      // arrayUnion/arrayRemove's exactly the caller's own uid into exactly
      // one sub-array, leaving the other two untouched; require that here
      // too (each branch below pins the other two arrays unchanged, so a
      // valid toggle on one can't smuggle a change into the others).
      allow update: if isAuth() && (
        resource.data.authorUid == request.auth.uid
        || resource.data.authorId  == request.auth.uid
        || (onlyFields(['reactions', 'updatedAt']) && (
              (isSelfUidToggle(resource.data.reactions.get('relate', []), request.resource.data.reactions.get('relate', []))
                && request.resource.data.reactions.get('inspire', []) == resource.data.reactions.get('inspire', [])
                && request.resource.data.reactions.get('collab', [])  == resource.data.reactions.get('collab', []))
           || (isSelfUidToggle(resource.data.reactions.get('inspire', []), request.resource.data.reactions.get('inspire', []))
                && request.resource.data.reactions.get('relate', [])  == resource.data.reactions.get('relate', [])
                && request.resource.data.reactions.get('collab', [])  == resource.data.reactions.get('collab', []))
           || (isSelfUidToggle(resource.data.reactions.get('collab', []), request.resource.data.reactions.get('collab', []))
                && request.resource.data.reactions.get('relate', [])  == resource.data.reactions.get('relate', [])
                && request.resource.data.reactions.get('inspire', []) == resource.data.reactions.get('inspire', []))
           ))
      );
      allow delete: if isAuth()
        && (resource.data.authorUid == request.auth.uid
            || resource.data.authorId  == request.auth.uid);
    }

    // Playbooks — repeatable AI workflows. Persistent (no expiry).
    // Anyone signed in can read; only the author can create/edit/delete.
    // Non-owners may toggle the helpfulByUids array only.
    match /aiPlaybooks/{playbookId} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid;
      // P1 fix: helpfulByUids/viewCount were each a blanket onlyFields()
      // escape hatch. helpfulByUids is a real self-toggle (arrayUnion/
      // arrayRemove of the caller's own uid) — enforce that. viewCount has
      // no current app write site for this collection (dead counter as of
      // this pass, still closed defensively) — require a plain +1 bump.
      allow update: if isAuth() && (
        resource.data.authorUid == request.auth.uid
        || (onlyFields(['helpfulByUids'])
            && isSelfUidToggle(resource.data.helpfulByUids, request.resource.data.helpfulByUids))
        || (onlyFields(['viewCount'])
            && isCounterBump(resource.data.viewCount, request.resource.data.viewCount))
      );
      allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;
    }

    // Build Logs — persistent build-in-public entries.
    // Anyone signed in can read; only the author can create/edit/delete.
    // Non-owners may toggle the reactions map only.
    match /buildLogs/{logId} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid;
      // P1 fix: reactions is {relate:[],inspire:[],collab:[]} (uids), same
      // shape and same toggleBuildLogReaction() write pattern as sparks
      // above — was a blanket onlyFields() escape hatch.
      allow update: if isAuth() && (
        resource.data.authorUid == request.auth.uid
        || (onlyFields(['reactions']) && (
              (isSelfUidToggle(resource.data.reactions.get('relate', []), request.resource.data.reactions.get('relate', []))
                && request.resource.data.reactions.get('inspire', []) == resource.data.reactions.get('inspire', [])
                && request.resource.data.reactions.get('collab', [])  == resource.data.reactions.get('collab', []))
           || (isSelfUidToggle(resource.data.reactions.get('inspire', []), request.resource.data.reactions.get('inspire', []))
                && request.resource.data.reactions.get('relate', [])  == resource.data.reactions.get('relate', [])
                && request.resource.data.reactions.get('collab', [])  == resource.data.reactions.get('collab', []))
           || (isSelfUidToggle(resource.data.reactions.get('collab', []), request.resource.data.reactions.get('collab', []))
                && request.resource.data.reactions.get('relate', [])  == resource.data.reactions.get('relate', [])
                && request.resource.data.reactions.get('inspire', []) == resource.data.reactions.get('inspire', []))
           ))
      );
      allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;
    }
    match /reels/{reelId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid;
      // P1 fix: this `reels` collection (distinct from the live
      // `reelVibes` below) has no app write site at all — appears fully
      // superseded/dead — but sparks/views was still a blanket
      // onlyFields() escape hatch reachable by any raw client. Closed
      // defensively to a plain +1 bump each, same as other dead counters
      // in this pass.
      allow update: if isAuth() && (
        resource.data.authorUid == request.auth.uid
        || (onlyFields(['sparks', 'updatedAt'])
            && isCounterBump(resource.data.sparks, request.resource.data.sparks))
        || (onlyFields(['views', 'updatedAt'])
            && isCounterBump(resource.data.views, request.resource.data.views))
      );
      allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;
    }

    match /reelVibes/{reelId} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid;
      // Author can update their own reel (captions, etc.).
      // aiVerification is written by the server (admin SDK, verify-reel
      // endpoint) which bypasses rules entirely — no client rule needed for
      // it, and none should exist: the removed third branch here let the
      // author set their own aiVerification.hasOnly(['aiVerification']),
      // which is a self-attested verification bug, not a fix. It also used
      // a bare affectedKeys() call with no diff() receiver, which is a
      // runtime error under real Firestore (silently denies) — two reasons
      // to remove rather than repair it.
      // Other users can update only likedByUids/commentCount/viewCount
      // (social signals). P1 fix: this used to be a blanket onlyFields()
      // escape hatch — any of the three could be set to any value in one
      // write. likedByUids is a real self-toggle (arrayUnion/arrayRemove
      // of the caller's own uid); commentCount/viewCount are always
      // bumped by exactly 1 by the real write sites (a new comment /
      // a view ping) — require each of those properties explicitly.
      allow update: if isAuth() && (
        resource.data.authorUid == request.auth.uid
        || (onlyFields(['likedByUids'])
            && isSelfUidToggle(resource.data.likedByUids, request.resource.data.likedByUids))
        || (onlyFields(['commentCount'])
            && isCounterBump(resource.data.commentCount, request.resource.data.commentCount))
        || (onlyFields(['viewCount'])
            && isCounterBump(resource.data.viewCount, request.resource.data.viewCount))
      );
      allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;
    }

    // AI verification ops queue — written by server (admin SDK), read by ops only
    match /reel_verification_queue/{docId} {
      allow read:   if isAuth() && (isPlatformAdmin() || isOpsStaff());
      allow create: if false;  // server-side only via admin SDK
      allow update: if isAuth() && (isPlatformAdmin() || isOpsStaff());
      allow delete: if false;
    }

    match /perspective_posts/{postId} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid;
      // P1 fix (partial — see note): responses holds real, attributed
      // content objects (addPerspectiveResponse's arrayUnion), not a
      // counter, so this used to let any authed non-owner overwrite the
      // whole array with anything — delete every existing response,
      // tamper with one, or inject several fake ones in a single write.
      // Firestore's rules language can't extract "the newly added
      // element" from a list diff, so the new entry's authorUid can't be
      // verified here — that needs a real schema change (a responses
      // subcollection, mirroring the already-correct posts/{id}/comments
      // and ideas/{id}/comments pattern) to close fully. What IS
      // enforceable, and now enforced: every existing response must
      // survive byte-for-byte, and the array can only grow by exactly one
      // element per write — no deletions, no tampering, no bulk-inject.
      allow update: if isAuth() && (
        resource.data.authorUid == request.auth.uid
        || (onlyFields(['responses', 'updatedAt'])
            && request.resource.data.responses.size() == resource.data.responses.size() + 1
            && request.resource.data.responses.hasAll(resource.data.responses))
      );
      allow delete: if false;
    }

    match /wisdom_threads/{threadId} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid;
      // P1 fix: hearts/saves were a blanket onlyFields() escape hatch —
      // any authed non-owner could set either to any value. Both are
      // always bumped by exactly 1 by the real write sites; require that.
      allow update: if isAuth() && (
        resource.data.authorUid == request.auth.uid
        || (onlyFields(['hearts', 'updatedAt'])
            && isCounterBump(resource.data.hearts, request.resource.data.hearts))
        || (onlyFields(['saves', 'updatedAt'])
            && isCounterBump(resource.data.saves, request.resource.data.saves))
      );
      allow delete: if false;
    }

    match /ideas/{ideaId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid;
      // P1 fix: each of these three branches was a blanket onlyFields()
      // escape hatch — sparkCount/sparkedByUids/stage could be set to
      // anything in one write (including flipping stage straight to
      // 'shipped'), and commentCount/forkCount to any value.
      // sparkIdea() always toggles sparkedByUids by exactly the caller's
      // own uid, moves sparkCount by the matching +1/-1, and may also
      // move stage forward past a spark-count threshold — that threshold
      // math belongs in app code, not re-derived here, but stage is at
      // least pinned to a real IdeaStage value so it can't be set to
      // arbitrary garbage. commentCount/forkCount are always bumped by 1.
      allow update: if isAuth() && (
        resource.data.authorUid == request.auth.uid
        || (onlyFields(['sparkCount', 'sparkedByUids', 'stage', 'updatedAt'])
            && isSelfUidToggle(resource.data.sparkedByUids, request.resource.data.sparkedByUids)
            && ( (request.resource.data.sparkedByUids.size() > resource.data.sparkedByUids.size()
                    && isCounterBump(resource.data.sparkCount, request.resource.data.sparkCount))
              || (request.resource.data.sparkedByUids.size() < resource.data.sparkedByUids.size()
                    && request.resource.data.sparkCount == resource.data.sparkCount - 1)
               )
            && request.resource.data.stage in
                 ['seed', 'developing', 'arena_ready', 'in_progress', 'shipped', 'archived'])
        || (onlyFields(['commentCount', 'updatedAt'])
            && isCounterBump(resource.data.commentCount, request.resource.data.commentCount))
        || (onlyFields(['forkCount', 'updatedAt'])
            && isCounterBump(resource.data.forkCount, request.resource.data.forkCount))
      );
      allow delete: if false;
    }

    match /ideas/{ideaId}/comments/{commentId} {
      allow read:           if isAuth();
      allow create:         if isAuth()
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /idea_activity/{activityId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /opportunities/{opportunityId} {
      allow read:   if isAuth();
      // P1 fix: create now also requires isRecruiter(), same as jobs
      // above. Opportunity.recruiterId is already the real uid string
      // (unlike Job.recruiterId's numeric-id mismatch) — no separate
      // bug to fix here.
      allow create: if isAuth()
        && request.resource.data.recruiterId == request.auth.uid
        && isRecruiter();
      allow update: if isAuth()
        && resource.data.recruiterId == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.recruiterId == request.auth.uid;
    }

    match /opportunities/{opportunityId}/applicants/{applicantUid} {
      allow read: if isAuth() && (
        request.auth.uid == applicantUid
        || request.auth.uid ==
           get(/databases/$(database)/documents/opportunities/$(opportunityId)).data.recruiterId
      );
      allow create: if isAuth() && request.auth.uid == applicantUid;
      allow update, delete: if false;
    }

    match /opportunity_matches/{matchId} {
      allow read:  if isAuth() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /applications/{applicationId} {
      allow read: if isAuth() && (
        resource == null
        || resource.data.applicantUid == request.auth.uid
        || resource.data.recruiterUid == request.auth.uid
        || resource.data.recruiterId == request.auth.uid
        || isOpsStaff()
        || isPlatformAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.applicantUid == request.auth.uid
        || resource.data.recruiterUid == request.auth.uid
        || resource.data.recruiterId == request.auth.uid
        || isOpsStaff()
        || isPlatformAdmin()
      );
      allow delete: if false;
    }

    match /interviews/{interviewId} {
      allow read: if isAuth() && (
        resource == null
        || resource.data.recruiterId == request.auth.uid
        || resource.data.applicantUid == request.auth.uid
        || isOpsStaff()
        || isPlatformAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.recruiterId == request.auth.uid
        || resource.data.applicantUid == request.auth.uid
      );
      allow delete: if isAuth() && resource.data.recruiterId == request.auth.uid;
    }

    match /submissions/{submissionId} {
      allow read: if isAuth() && (
        resource == null
        || resource.data.authorUid == request.auth.uid
        || resource.data.recruiterUid == request.auth.uid
        || isPlatformAdmin()
      );
      allow create: if isAuth() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.authorUid == request.auth.uid
        || resource.data.recruiterUid == request.auth.uid
      );
      allow delete: if false;
    }

    match /talentPool/{entryId} {
      allow read: if isAuth() && (
        resource == null
        || resource.data.recruiterId == request.auth.uid
      );
      allow create: if isAuth()
        && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isAuth()
        && resource.data.recruiterId == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.recruiterId == request.auth.uid;
    }

    match /outreachTemplates/{templateId} {
      allow read: if isAuth() && (
        resource == null
        || resource.data.recruiterId == request.auth.uid
      );
      allow create: if isAuth()
        && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isAuth()
        && resource.data.recruiterId == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.recruiterId == request.auth.uid;
    }

    match /verificationRequests/{requestId} {
      allow read: if isAuth() && (
        resource == null
        || resource.data.recruiterUid == request.auth.uid
        || resource.data.requestedBy == request.auth.uid
        || isOpsStaff()
        || isPlatformAdmin()
      );
      allow create: if isAuth() && (
        request.resource.data.recruiterUid == request.auth.uid
        || request.resource.data.requestedBy == request.auth.uid
      );
      allow update: if isOpsStaff() || isPlatformAdmin();
      allow delete: if isAuth() && (
        isOpsStaff()
        || isPlatformAdmin()
        || exists(/databases/$(database)/documents/companies/$(resource.data.companyId))
           && get(/databases/$(database)/documents/companies/$(resource.data.companyId)).data.adminUid == request.auth.uid
      );
    }

    // ── DATA EXPORT REQUESTS ──────────────────────────────────────────────────
    // Users submit export requests; ops staff reviews and approves
    match /data_requests/{requestId} {
      allow read:   if isAuth() && (resource.data.uid == request.auth.uid || isOpsStaff());
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isOpsStaff();  // ops approves, sets downloadUrl
      allow delete: if false;
    }

    match /recruiter_applications/{appId} {
      allow read: if isAuth() && (
        resource.data.uid == request.auth.uid
        || isOpsStaff()
        || isPlatformAdmin()
      );
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOpsStaff() || isPlatformAdmin();
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // BRANDED ARENAS
    // ═══════════════════════════════════════════════════════════════════

    match /arena_industries/{industryId} {
      allow read:  if true;
      allow write: if false;
    }

    match /industry_verifications/{verificationId} {
      allow read:           if isAuth()
                              && resource.data.recruiterUid == request.auth.uid;
      allow create:         if isAuth();
      allow update, delete: if false;
    }

    match /arena_challenge_drafts/{draftId} {
      allow read:   if isAuth() && resource.data.recruiterId == request.auth.uid;
      allow create: if isAuth()
                      && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isAuth() && resource.data.recruiterId == request.auth.uid;
      allow delete: if false;
    }

    match /arena_challenges/{challengeId} {
      allow read: if isAuth() && (
        resource == null
        || resource.data.verificationStatus == 'live'
        || resource.data.recruiterId == request.auth.uid
      );
      allow create: if isAuth()
        && request.resource.data.recruiterId == request.auth.uid
        && (
          request.resource.data.verificationStatus == 'pending_ops'
          || (
            request.resource.data.verificationStatus == 'live'
            && isPlatformAdmin()
          )
        );
      allow update: if isAuth() && (
        (
          resource.data.recruiterId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'verificationStatus', 'stripePaymentIntentId', 'stripeSessionId',
               'shortlistedUids', 'isVerifiedPoster', 'isRegulatedPoster',
               'companyId', 'recruiterId', 'arenaIndustry', 'liveDate', 'closedAt'
             ])
        )
        // P1 fix: viewCount was a blanket onlyFields() escape hatch — any
        // authed user could set it to any value. The real write site
        // (arenaService.ts) always bumps it by exactly 1.
        || (onlyFields(['viewCount'])
            && isCounterBump(resource.data.viewCount, request.resource.data.viewCount))
        || (
          resource.data.recruiterId == request.auth.uid
          && onlyFields(['shortlistedUids', 'updatedAt'])
        )
        || isPlatformAdmin()
      );
      allow delete: if false;
    }

    match /arena_challenges/{challengeId}/submissions/{submissionId} {
      allow read: if isAuth() && (
        resource.data.authorUid == request.auth.uid
        || resource.data.challengeRecruiterId == request.auth.uid
      );
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuth()
        && resource.data.authorUid == request.auth.uid;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // FACTORY PIPELINE — factory.bewatu.com
    // ═══════════════════════════════════════════════════════════════════

    match /factory_users/{uid} {
      allow read:   if isAuth();
      allow create: if isAuth() && isOwner(uid);
      allow update: if isAuth() && isOwner(uid);
      allow delete: if false;

      match /notifications/{notifId} {
        allow read:   if isAuth() && isOwner(uid);
        allow update: if isAuth() && isOwner(uid);
        allow write:  if false;
      }
    }

    match /factory_problems/{id} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.authorUid == request.auth.uid
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['views', 'upvotes'])
      );
      allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;
    }

    match /factory_solutions/{id} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.author.id == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
      );
      allow delete: if false;
    }

    match /factory_ideas/{id} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.author.id == request.auth.uid
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['upvotes', 'votedBy', 'updatedAt'])
      );
      allow delete: if false;
    }

    match /factory_teams/{id} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid;
      // TODO(confirm): requires a flat memberUids: string[] written alongside
      // the existing members:[{user,role,joinedAt}] array — rules cannot map
      // over an array of maps, so a flat uid array is needed to check membership
      // (same pattern already used by funding_offers.founderUids below).
      allow update: if isAuth() && (
        resource.data.createdBy == request.auth.uid
        || (resource.data.memberUids is list && resource.data.memberUids.hasAny([request.auth.uid]))
      );
      allow delete: if false;
    }

    match /factory_team_posts/{id} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuth() && resource.data.authorUid == request.auth.uid;
      allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;
    }

    match /factory_projects/{id} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.createdBy == request.auth.uid
        // team members (via the parent team's memberUids) can update project status
        || (
          resource.data.teamId != null &&
          get(/databases/$(database)/documents/factory_teams/$(resource.data.teamId)).data.memberUids.hasAny([request.auth.uid])
        )
      );
      allow delete: if false;
    }

    match /factory_startups/{id} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid;
      // TODO(confirm): requires a flat founderUids: string[] written alongside
      // the existing founders:[{id,name,avatar,role}] array (same convention
      // funding_offers.founderUids already uses).
      // P1 fix: viewCount was a blanket onlyFields() escape hatch. No
      // write site for it was found in either BeWatu_V3 or bewatu-factory
      // (dead counter as of this pass) — closed defensively to a plain
      // +1 bump, same as the other dead viewCount fields in this pass.
      allow update: if isAuth() && (
        resource.data.createdBy == request.auth.uid
        || (resource.data.founderUids is list && resource.data.founderUids.hasAny([request.auth.uid]))
        || (onlyFields(['viewCount', 'updatedAt'])
            && isCounterBump(resource.data.viewCount, request.resource.data.viewCount))
      );
      allow delete: if false;
    }

    match /factory_investors/{id} {
      // Decision 4: REVIEWED onboarding. An investor profile is created
      // only by the server, after ops/admin approves the applicant's
      // investor_applications doc — consistent with the recruiter 4-gate
      // flow and "Factory is invite-only at launch." No client create.
      allow read:   if isAuth();
      allow create: if false;
      allow update: if isAuth() && (
        resource.data.user.id == request.auth.uid
        || isPlatformAdmin()
      );
      allow delete: if false;
    }

    match /factory_funding_rounds/{id} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.createdBy == request.auth.uid
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['raisedAmount', 'investors'])
      );
      allow delete: if false;
    }

    match /factory_incubators/{id} {
      // Curated program content — no client ever creates/updates these
      // (confirmed: no addDoc/updateDoc call in the app touches this doc,
      // only the applications subcollection below). Ops/admin only.
      allow read:   if isAuth();
      allow create: if isAuth() && (isPlatformAdmin() || isOpsStaff());
      allow update: if isAuth() && (isPlatformAdmin() || isOpsStaff());
      allow delete: if false;

      match /applications/{applicationId} {
        allow read:   if isAuth() && (
          resource.data.founderUid == request.auth.uid
          || isPlatformAdmin() || isOpsStaff()
        );
        allow create: if isAuth()
          && request.resource.data.founderUid == request.auth.uid;
        // Only ops/admin change application status — the founder cannot
        // self-approve.
        allow update: if isAuth() && (isPlatformAdmin() || isOpsStaff());
        allow delete: if false;
      }
    }

    match /factory_activities/{id} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow delete: if false;
    }

    match /factory_reputation/{uid} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /factory_invites/{id} {
      allow read:   if isAuth() && resource.data.targetUid == request.auth.uid;
      allow create: if false;
      allow update: if isAuth()
        && resource.data.targetUid == request.auth.uid
        && onlyFields(['acceptedAt']);
      allow delete: if false;
    }

    match /factory_notifications/{notifId} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow update: if isAuth()
        && resource.data.uid == request.auth.uid
        && onlyFields(['read', 'readAt']);
      allow create: if false;
      allow delete: if false;
    }

    match /investor_applications/{id} {
      // Field-name fix: the rule checked `applicantUid`, but
      // InvestorOnboarding.tsx writes `uid` (matching the convention its
      // sibling recruiter_applications already uses — that one correctly
      // checks `uid`, not `applicantUid`). As written, no investor could
      // ever submit an application once this collection came alive — every
      // create would deny.
      allow read: if isAuth() && (
        resource.data.uid == request.auth.uid
        || isOpsStaff()
        || isPlatformAdmin()
      );
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOpsStaff() || isPlatformAdmin();
      allow delete: if false;
    }

    match /funding_offers/{offerId} {
      allow read: if isAuth() && (
        resource.data.investorUid == request.auth.uid
        || resource.data.founderUids.hasAny([request.auth.uid])
      );
      allow create: if isAuth() && isFactoryInvestor()
        && request.resource.data.investorUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        (
          resource.data.investorUid == request.auth.uid
          && request.resource.data.status == 'withdrawn'
          && onlyFields(['status', 'history', 'updatedAt'])
        )
        || (
          resource.data.founderUids.hasAny([request.auth.uid])
          && request.resource.data.status in ['accepted', 'declined', 'countered']
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'investorUid', 'investorName', 'startupId', 'createdAt'
             ])
        )
      );
      allow delete: if false;
    }

    match /funding_rounds/{roundId} {
      allow read: if isAuth() && (
        resource.data.investorUid == request.auth.uid
        || resource.data.founderUids.hasAny([request.auth.uid])
      );
      allow write: if false;
    }

    match /demo_availability/{uid} {
      allow read:  if isAuth();
      allow write: if isAuth() && request.auth.uid == uid;
    }

    match /availability/{uid} {
      allow read:  if isAuth();
      allow write: if isAuth() && request.auth.uid == uid;
    }

    match /demo_sessions/{sessionId} {
      allow read: if isAuth() && (
        resource.data.investorUid == request.auth.uid
        || resource.data.founderUids.hasAny([request.auth.uid])
      );
      allow create: if isAuth() && isFactoryInvestor()
        && request.resource.data.investorUid == request.auth.uid;
      allow update: if isAuth() && (
        (
          resource.data.investorUid == request.auth.uid
          && onlyFields(['outcome', 'outcomeRecordedAt', 'updatedAt'])
        )
        || (
          resource.data.founderUids.hasAny([request.auth.uid])
          && onlyFields(['founderNote', 'updatedAt'])
        )
      );
      allow delete: if false;
    }

    match /demo_requests/{id} {
      allow read: if isAuth() && (
        resource.data.investorUid == request.auth.uid
        || resource.data.founderUid == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.investorUid == request.auth.uid
        || resource.data.founderUid == request.auth.uid
      );
      allow delete: if false;
    }

    match /xp/{uid} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /reputation/{uid} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /startups/{id} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && resource.data.createdBy == request.auth.uid;
      allow delete: if false;
    }

  }
  }

