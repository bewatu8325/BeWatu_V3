{
  "rewrites": [
    { "source": "/be/:username", "destination": "/index.html" },
    { "source": "/be/:username/work", "destination": "/api/portfolio?u=:username" },
    { "source": "/w/:token", "destination": "/api/portfolio?t=:token" },
    { "source": "/talks/:id", "destination": "/api/talks?id=:id" },
    { "source": "/endorse/:token", "destination": "/index.html" },
    { "source": "/invite/:token", "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|slack-imgproxy|telegrambot|discordbot|whatsapp/|skypeuripreview|embedly|pinterestbot|redditbot|applebot|googlebot|bingbot|vkshare|iframely|mastodon|bluesky).*" }], "destination": "/api/invitations?og=1&t=:token" },
    { "source": "/invite/:token", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/community-guidelines", "destination": "/index.html" },
    { "source": "/companies", "destination": "/index.html" },
    { "source": "/companies/:id", "destination": "/index.html" },
    { "source": "/organizations", "destination": "/index.html" },
    { "source": "/organizations/:id", "destination": "/index.html" },
    { "source": "/arenas", "destination": "/index.html" },
    { "source": "/arenas/:path*", "destination": "/index.html" },
    { "source": "/prove", "destination": "/index.html" },
    { "source": "/discover", "destination": "/index.html" },
    { "source": "/discover/:path*", "destination": "/index.html" },
    { "source": "/community", "destination": "/index.html" },
    { "source": "/community/:path*", "destination": "/index.html" },
    { "source": "/messages", "destination": "/index.html" },
    { "source": "/jobs", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/healthcheck",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/invitations?cron=1",
      "schedule": "15 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=(self \"https://js.stripe.com\")"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://js.stripe.com https://apis.google.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; media-src 'self' blob: https://firebasestorage.googleapis.com; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebasestorage.googleapis.com https://www.googleapis.com https://api.stripe.com https://m.stripe.network wss://*.firebaseio.com; frame-src https://js.stripe.com https://hooks.stripe.com https://bewatu-2d04e.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';"
        }
      ]
    },
    {
      "source": "/invite/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
