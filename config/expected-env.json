  "recommended": ["SECURITY_ALERT_EMAIL", "STRIPE_INVESTOR_WEBHOOK_SECRET", "STRIPE_INVESTOR_PRICE_ID", "ANTHROPIC_API_KEY"],
  "publicByDesign": ["VITE_FIREBASE_API_KEY", "VITE_FIREBASE_PROJECT_ID", "VITE_FIREBASE_STORAGE_BUCKET", "VITE_FIREBASE_MESSAGING_SENDER_ID", "VITE_FIREBASE_APP_ID", "VITE_SENTRY_DSN", "VITE_ALGOLIA_SEARCH_KEY"]
